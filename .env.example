# ==============================================================================
# OCPR COMORES — Configuration d'Environnement (Hostinger & MySQL)
# ==============================================================================

# 1. Connexion Base de Données MySQL Hostinger
# ------------------------------------------------------------------------------
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_BASE
#
# Exemples :
# - Sur Hébergement Web Mutualisé / Cloud Hostinger (hPanel) :
#   DATABASE_URL="mysql://u123456789_admin:VotreMotDePasseFort2026!@localhost:3306/u123456789_ocpr_db"
#
# - Sur Hostinger VPS (MySQL local sur le même VPS) :
#   DATABASE_URL="mysql://ocpr_user:VotreMotDePasseFort2026!@127.0.0.1:3306/ocpr_db"
#
# - Sur Hostinger Remote MySQL (Base distante) :
#   DATABASE_URL="mysql://u123456789_admin:VotreMotDePasseFort2026!@sql123.hostinger.com:3306/u123456789_ocpr_db?ssl=true"
#
DATABASE_URL="mysql://root:password@127.0.0.1:3306/ocpr_db"

# Taille maximale du pool de connexions MySQL (recommandé: 5 pour hébergement partagé, 10-20 pour VPS)
DB_POOL_SIZE=10

# Activer SSL pour MySQL si votre serveur l'exige (true / false)
DB_SSL=false

# 2. Sécurité et Authentification JWT Admin
# ------------------------------------------------------------------------------
# Clé secrète ultra-sécurisée pour la signature des jetons de session Admin (générez une chaîne aléatoire de 32+ caractères)
JWT_SECRET="remplacez_ceci_par_une_cle_secrete_tres_longue_et_aleatoire_2026"

# Identifiants du Super Administrateur par défaut (utilisés par le seed et en fallback dev)
ADMIN_DEFAULT_EMAIL="admin@ocprcomores.com"
ADMIN_DEFAULT_NAME="Direction OCPR Comores"
ADMIN_DEFAULT_PASSWORD="Admin@OCPR2026!"

# 3. Paramètres Serveur Web
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# 4. Service d'Envoi d'Emails (Formulaire de Contact vers l'Organisation)
# ------------------------------------------------------------------------------
# Pour Hostinger Webmail / Titan Mail :
# Hôte SMTP : smtp.hostinger.com (Port 465 SSL ou 587 TLS)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@ocprcomores.com"
SMTP_PASS="VotreMotDePasseEmailHostinger2026!"

# Adresse email de réception des messages pour l'organisation OCPR
CONTACT_RECEIVER_EMAIL="info@ocprcomores.com"

# Nom d'affichage et adresse d'expédition
SMTP_FROM='"Portail OCPR Comores" <info@ocprcomores.com>'

