# ==============================================================================
# OCPR COMORES — Variables d'environnement de Production / cPanel
# ==============================================================================

# 1. Environnement
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# 2. URL publique de l'application
NEXT_PUBLIC_APP_URL=https://ocprcomores.com

# 3. Sécurité & Authentification JWT (OBLIGATOIRE EN PRODUCTION)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=votre_cle_secrete_jwt_robuste_ici_minimum_32_caracteres

# 4. Base de données MySQL / MariaDB (cPanel)
# Format standard TCP (remplacez cpaneluser, dbname, motdepasse) :
DATABASE_URL="mysql://cpaneluser_dbuser:motdepasse@127.0.0.1:3306/cpaneluser_ocprdb"

# OU configuration détaillée si vous préférez séparer les variables :
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=cpaneluser_dbuser
# DB_PASSWORD=motdepasse
# DB_NAME=cpaneluser_ocprdb
# DB_SOCKET=/var/lib/mysql/mysql.sock

# 5. Compte Administrateur initial (Optionnel - pour seed/initialisation)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=MotDePasseTresSecurise2026!

# 6. Configuration Email (SMTP cPanel)
SMTP_HOST=mail.ocprcomores.com
SMTP_PORT=465
SMTP_USER=contact@ocprcomores.com
SMTP_PASS=motdepasse_email
SMTP_FROM="OCPR Comores <contact@ocprcomores.com>"
